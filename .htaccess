# Prevent directory listing
Options -Indexes

# Protect sensitive files from direct access
<FilesMatch "(^\.env|^\.env\..*|\.log$|\.sql$|composer\.(json|lock)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protect the includes directory from direct browser access
# (Files inside are not executable directly, but we block them anyway)
<FilesMatch "^(security|permissions|auth|audit|dotenv|api-auth|header|sidebar|footer)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Security Headers (fallback - PHP also sets these; kept consistent with setSecurityHeaders())
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS is honored by browsers only over HTTPS; harmless on local HTTP dev.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# Block common secret/config remnants anywhere in the tree
<FilesMatch "(^config\.bak$|\.bak$|\.orig$|~$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# WP12: never serve version control, dependency manifests, cron internals,
# or vendor sources (cron PHP files are CLI-guarded too — defense in depth).
# NOTE: RedirectMatch is rejected by this stack — mod_rewrite instead.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.git(/|$) - [F]
    RewriteRule ^(cron|vendor)(/|$) - [F]
</IfModule>