# 1100ERP environment template. Copy to .env (local dev) or
# APP_SECRETS_FILE (production, outside the web root). Never commit real values.
DB_HOST=localhost
DB_NAME=1100erp
DB_USER=root
DB_PASS=
DB_PREFIX=erp_
# 32+ character secret for encrypted backups (see cron/backup.sh / DEPLOY.md).
ENCRYPTION_KEY=change-me-to-a-random-32-character-string
# Optional: absolute path to a secrets file outside the web root.
# When set, it is loaded before .env (real environment variables always win).
#APP_SECRETS_FILE=/etc/erp/secrets.env
